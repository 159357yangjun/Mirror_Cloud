{
  "version": "1.0",
  "project": {
    "name": "Mirror Cloud 七页任务驱动信息架构 G1 V2 草案",
    "primary_user": "首次使用与日常管理图片的 Windows 桌面用户；操作频率仍待 G0 真实用户验证",
    "platform": "desktop",
    "patterns": [
      "business-workflow",
      "object-management",
      "monitoring-analysis",
      "guided-wizard"
    ]
  },
  "tasks": [
    {
      "id": "T1",
      "name": "首次连接云端并发布图片",
      "frequency": "high",
      "success_criterion": "任务与资源页出现同一提交的可信状态和可检查的部署；不能将入队等同于上传成功",
      "step_budget": 3,
      "steps": [
        "configure-storage",
        "choose-source",
        "submit-upload"
      ]
    },
    {
      "id": "T2",
      "name": "查找已发布资源并复制公开链接",
      "frequency": "high",
      "success_criterion": "定位资源并复制已存在且允许公开的链接，私有对象通过独立限时分享流程",
      "step_budget": 2,
      "steps": [
        "find-asset",
        "copy-public-link"
      ]
    },
    {
      "id": "T3",
      "name": "定位并恢复失败任务",
      "frequency": "medium",
      "success_criterion": "查清失败原因并重试允许重试的失败项，重新在任务和资源确认结果",
      "step_budget": 2,
      "steps": [
        "inspect-failure",
        "retry-failed-task"
      ]
    },
    {
      "id": "T4",
      "name": "浏览与维护真实远端云文件",
      "frequency": "medium",
      "success_criterion": "目标StorageEntry ID/路径有实际读数；执行结果与任务可核对；取消删除时零调用",
      "step_budget": 2,
      "steps": [
        "browse-remote",
        "operate-on-remote"
      ]
    },
    {
      "id": "T5",
      "name": "配置云端与切换发布目标",
      "frequency": "high",
      "success_criterion": "目标ID在发布区实际生效；测试连接读写风险和访问权限未验证项明确",
      "step_budget": 2,
      "steps": [
        "configure-storage",
        "choose-default-target"
      ]
    },
    {
      "id": "T6",
      "name": "管理插件与 AI 能力权限",
      "frequency": "medium",
      "success_criterion": "敏感权限申请/拒绝/撤销可查，绝不默认广泛授权",
      "step_budget": 2,
      "steps": [
        "review-plugin-permission",
        "authorize-plugin"
      ]
    },
    {
      "id": "T7",
      "name": "调整输出格式和 Typora 集成",
      "frequency": "medium",
      "success_criterion": "实际复制内容符合设置值，集成失败可恢复",
      "step_budget": 2,
      "steps": [
        "edit-output-preferences",
        "verify-output"
      ]
    },
    {
      "id": "T8",
      "name": "审查并激活配置迁移",
      "frequency": "medium",
      "success_criterion": "预览映射、风险确认和最终激活有真实证据且不可误覆盖",
      "step_budget": 2,
      "steps": [
        "preview-migration",
        "activate-migration"
      ]
    },
    {
      "id": "T9",
      "name": "验证更新、安装与版本变化",
      "frequency": "medium",
      "success_criterion": "下载/安装/重启后的实际版本三者区分，失败有回滚指引",
      "step_budget": 3,
      "steps": [
        "check-update",
        "download-update",
        "install-update"
      ]
    },
    {
      "id": "T10",
      "name": "在错误处打开教程并返回原对象",
      "frequency": "high",
      "success_criterion": "引导关闭后保留来源页、对象和字段；无敏感数据存储",
      "step_budget": 2,
      "steps": [
        "open-context-guide",
        "return-to-context"
      ]
    }
  ],
