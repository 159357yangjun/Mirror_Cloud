{
  "id": "example.markdown-card",
  "name": "Markdown Card Example",
  "version": "1.0.0",
  "description": "Example manifest for a template plugin",
  "kind": "template",
  "permissions": [
    "read_asset"
  ],
  "config_schema": {
    "template": {
      "type": "string",
      "title": "Markdown 模板",
      "default": "![{name}]({url})"
    }
  },
  "api_version": 1,
  "schema_version": 1,
  "hooks": [
    "after_upload",
    "manual_trigger"
  ]
}
