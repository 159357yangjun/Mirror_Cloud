{
  "id": "example.webhook",
  "name": "Webhook Example",
  "version": "1.0.0",
  "description": "Example manifest for a webhook plugin",
  "kind": "webhook",
  "permissions": [
    "read_asset",
    "network",
    "external_write"
  ],
  "config_schema": {
    "endpoint": {
      "type": "url",
      "title": "Webhook 地址",
      "required": true
    }
  },
  "api_version": 1,
  "schema_version": 1,
  "hooks": [
    "after_upload",
    "manual_trigger"
  ]
}
