---
import { providerGuides, type ProviderKey } from '../data/providerGuides';
interface Props { provider: ProviderKey }
const { provider } = Astro.props;
const guide = providerGuides[provider];
---

<section class="provider-start" aria-label={`${guide.title} 配置准备`}>
  <div class="provider-start-heading"><span class="guide-eyebrow">配置入口</span><span class="guide-count">{guide.fields.length} 个字段</span></div>
  <p class="provider-prepare"><strong>准备信息</strong>{guide.prepare}</p>
  <div class="provider-links" aria-label="平台直达入口">
    {guide.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}
  </div>
  <div class="provider-app-path"><span>软件位置</span><strong>镜云 → 云端 → 添加存储 → {guide.title}</strong></div>
  <p class="provider-privacy">账号和密钥在镜云应用内填写，本网站不收集。</p>
  <a class="provider-jump" href="#configuration-fields">查看字段填写说明 <span aria-hidden="true">↓</span></a>
</section>
