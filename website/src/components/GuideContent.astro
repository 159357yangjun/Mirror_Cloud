---
const { toc } = Astro.locals.starlightRoute;
---

<div class="guide-content">
  {toc && (
    <nav class="guide-outline print:hidden" aria-label="本页步骤">
      <details>
        <summary>本页步骤 <span>{toc.items.length} 个章节</span></summary>
        <div class="guide-outline-links">{toc.items.map((item) => <a href={`#${item.slug}`}>{item.text}</a>)}</div>
      </details>
    </nav>
  )}
  <div class="guide-article"><slot /></div>
</div>
